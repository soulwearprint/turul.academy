# Copy to .env and start with:  uvicorn app.main:app --env-file .env --port 8080

# Where the SQLite database lives (default: ./data/santa.db)
# SANTA_DB=./data/santa.db

# Set to 1 when served over HTTPS
SANTA_SECURE_COOKIE=0

# ── Sending e-mail (leave SMTP_HOST empty = "outbox mode", .eml files in data/outbox/) ──
# Resend:   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=<API key>
# Gmail:    SMTP_HOST=smtp.gmail.com   SMTP_PORT=465  SMTP_USER=<you@gmail.com>  SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=santa@your-domain.example
MAIL_FROM_NAME=Santa Claus · North Pole
