# Copy to .env and start with:  uvicorn app.main:app --env-file .env --port 8080

# Where the SQLite database lives (default: ./data/santa.db)
# SANTA_DB=./data/santa.db

# Set to 1 when served over HTTPS
SANTA_SECURE_COOKIE=0

# ── Sending e-mail (leave SMTP_HOST empty = "outbox mode", .eml files in data/outbox/) ──
# Resend:   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=<API key>
# Gmail:    SMTP_HOST=smtp.gmail.com   SMTP_PORT=465  SMTP_USER=<you@gmail.com>  SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=santa@your-domain.example
MAIL_FROM_NAME=Santa Claus · North Pole
# Optional per-language sender name (defaults: "Mikulás · Északi-sark" / "Santa Claus · North Pole")
# MAIL_FROM_NAME_HU=Mikulás · Északi-sark
# MAIL_FROM_NAME_EN=Santa Claus · North Pole

# ── Google sign-in (optional; all four below must be set to enable it) ──
# Authorised redirect URI in Google Cloud Console: {PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://santa.example.com
# 32 random bytes, base64. Generate:  python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Keep it OUT of the database backup; losing it locks Google-only admins out of the matches.
SANTA_SERVER_KEY=
# The only Google account allowed to create admin #1 (required for Google setup)
SANTA_FIRST_ADMIN_EMAIL=
